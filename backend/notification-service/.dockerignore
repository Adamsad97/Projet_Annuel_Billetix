# Dépendances — réinstallées dans le conteneur via npm install
node_modules

# Build TypeScript — reconstruit dans le conteneur
dist
*.tsbuildinfo

# Tests — inutiles en production
coverage
**/*.spec.ts
**/*.test.ts
test/
jest.config.*
jest.config.js
jest.config.ts

# Environnement — injecté via docker-compose / secrets
.env
.env.*
!.env.example

# Logs
*.log
logs/

# Git — peut faire plusieurs centaines de Mo
.git
.gitignore
.gitattributes

# Docker — inutile dans l'image elle-même
Dockerfile*
docker-compose*.yml
.dockerignore

# Documentation
*.md
README*
CHANGELOG*

# IDE
.vscode/
.idea/
*.swp
*.swo
*.sublime-*

# OS
.DS_Store
Thumbs.db
desktop.ini

