<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{headline}}</title>
  <style>
    body { font-family: Arial, sans-serif; background: #f5f5f5; margin: 0; padding: 0; }
    .container { max-width: 600px; margin: 40px auto; background: #fff; border-radius: 8px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,0.1); }
    .header { background: #6c3de0; padding: 32px; text-align: center; }
    .header h1 { color: #fff; margin: 0; font-size: 28px; }
    .body { padding: 32px; color: #333; line-height: 1.6; }
    .event-name { font-size: 18px; font-weight: bold; color: #1a1a1a; margin: 8px 0 16px; }
    .message-box { background: #f3f0ff; border-left: 4px solid #6c3de0; padding: 16px; border-radius: 4px; margin: 16px 0; color: #1f1147; white-space: pre-line; }
    .message-box.warning { background: #fff7ed; border-left-color: #f97316; color: #7c2d12; }
    .message-box.danger { background: #fef2f2; border-left-color: #ef4444; color: #7f1d1d; }
    .message-box.success { background: #ecfdf5; border-left-color: #10b981; color: #064e3b; }
    .btn-wrap { text-align: center; }
    .btn { display: inline-block; margin: 24px 0 8px; padding: 14px 32px; background: #6c3de0; color: #fff !important; text-decoration: none; border-radius: 6px; font-weight: bold; }
    .note { font-size: 13px; color: #666; }
    .footer { padding: 20px 32px; background: #f9f9f9; color: #999; font-size: 12px; text-align: center; }
  </style>
</head>
<body>
  <div class="container">
    <div class="header"><h1>BilleTix</h1></div>
    <div class="body">
      <h2>{{headline}}</h2>
      <p>Bonjour {{firstName}},</p>
      <p>{{intro}}</p>
      <div class="event-name">{{eventName}}</div>
      {{#if message}}
      <div class="message-box {{tone}}">
        <strong>{{messageLabel}} :</strong><br>{{message}}
      </div>
      {{/if}}
      {{#if details}}
      <p>{{details}}</p>
      {{/if}}
      <div class="btn-wrap">
        <a href="{{eventUrl}}" class="btn">{{ctaLabel}}</a>
      </div>
      <p class="note">Pour toute question, répondez depuis votre espace organisateur ou contactez notre support.</p>
    </div>
    <div class="footer">© {{year}} BilleTix — Tous droits réservés</div>
  </div>
</body>
</html>
