# ══════════════════════════════════════════════════════════════════
# BILLETIX — Variables d'environnement
# Copier ce fichier en .env et remplir toutes les valeurs
# NE JAMAIS committer le fichier .env
# ══════════════════════════════════════════════════════════════════

# ── Docker Compose ─────────────────────────────────────────────────
# Fait en sorte que `docker compose ...` (sans -f) charge automatiquement
# la config dev (hot-reload) en plus de la config de base.
# Séparateur : ";" sous Windows, ":" sous Linux/macOS.
COMPOSE_FILE=docker-compose.yml;docker-compose.dev.yml

# ── PostgreSQL ─────────────────────────────────────────────────────
# Identifiants partagés par les 7 bases dédiées (une par service :
# auth-db, user-db, event-db, order-db, ticket-db, payment-db, admin-db).
# Chaque base est un conteneur/volume distinct — seuls les identifiants
# de connexion sont mutualisés, pas les données.
POSTGRES_USER=billetix
POSTGRES_PASSWORD=changeme_postgres

# ── Redis ──────────────────────────────────────────────────────────
REDIS_PASSWORD=changeme_redis
REDIS_PORT=6379

# ── RabbitMQ ───────────────────────────────────────────────────────
RABBITMQ_USER=billetix
RABBITMQ_PASSWORD=changeme_rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# ── MinIO (stockage S3 local) ──────────────────────────────────────
MINIO_ROOT_USER=billetix
MINIO_ROOT_PASSWORD=changeme_minio_at_least_8_chars
# Hôte joignable depuis le navigateur pour les URLs de fichiers (posters,
# avatars, documents, PDF billets) — mettre le domaine public en prod.
MINIO_PUBLIC_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET_INVOICES=invoices
MINIO_BUCKET_POSTERS=posters
MINIO_BUCKET_AVATARS=avatars
MINIO_BUCKET_DOCUMENTS=documents

# ── Mailpit (SMTP dev local, UI http://localhost:8025) ───────────────────────────────────────
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# ── JWT ────────────────────────────────────────────────────────────
# Générer avec : node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Durées d'expiration : plus de variable d'env, configurables par l'admin
# via platform_settings (jwt_access_expires_in_minutes / jwt_refresh_expires_in_days).
JWT_ACCESS_SECRET=changeme_jwt_access_secret_minimum_32_chars
JWT_REFRESH_SECRET=changeme_jwt_refresh_secret_minimum_32_chars

# ── Bootstrap admin (premier déploiement uniquement) ─────────────────
# Ne s'active QUE si aucun compte ADMIN n'existe déjà en base — jamais de
# recréation/écrasement ensuite. Peut rester en place sans risque, mais
# retirer BOOTSTRAP_ADMIN_PASSWORD après la première connexion est recommandé.
BOOTSTRAP_ADMIN_EMAIL=admin@billetix.local
BOOTSTRAP_ADMIN_PASSWORD=changeme_choisir_un_mot_de_passe_fort

# ── Sécurité ───────────────────────────────────────────────────────
# Clé AES-256 pour chiffrement IBAN (32 bytes en hex = 64 caractères)
# Générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IBAN_ENCRYPTION_KEY=changeme_iban_key_64_hex_chars_0000000000000000

# ── OAuth Google ───────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback

# ── OAuth Facebook ─────────────────────────────────────────────────
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
FACEBOOK_CALLBACK_URL=http://localhost:4000/api/v1/auth/facebook/callback

# ── Stripe ─────────────────────────────────────────────────────────
# Clés de test disponibles sur dashboard.stripe.com
STRIPE_SECRET_KEY=sk_test_...
# L'endpoint webhook (POST /payments/webhook/stripe) DOIT être abonné à ces
# événements dans le dashboard Stripe (Developers > Webhooks), sans quoi
# Stripe ne les enverra jamais :
#   - payment_intent.succeeded        (confirmation de paiement)
#   - payment_intent.payment_failed   (email "échec du paiement" à l'acheteur)
STRIPE_WEBHOOK_SECRET=whsec_...
# Clé publiable (pas secrète) — utilisée côté frontend par Stripe.js/Elements.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# ── PayPal ─────────────────────────────────────────────────────────
# Identifiants sandbox sur developer.paypal.com > My Apps & Credentials
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_MODE=sandbox
# ID du webhook (POST /payments/webhook/paypal) créé dans le dashboard PayPal
# Developer, abonné à l'événement CHECKOUT.ORDER.APPROVED. Nécessaire pour
# vérifier la signature des webhooks entrants.
PAYPAL_WEBHOOK_ID=

# ── Orange Money ───────────────────────────────────────────────────
# ⚠️ Intégration jamais testée en conditions réelles (aucun compte marchand
# disponible pour ce projet) — identifiants sur developer.orange.com
ORANGE_MONEY_CLIENT_ID=
ORANGE_MONEY_CLIENT_SECRET=
ORANGE_MONEY_MERCHANT_KEY=
ORANGE_MONEY_API_BASE=https://api.orange.com
ORANGE_MONEY_COUNTRY=sn
ORANGE_MONEY_CURRENCY=OUV

# ── Wave ───────────────────────────────────────────────────────────
# ⚠️ Intégration jamais testée en conditions réelles (aucun compte marchand
# disponible pour ce projet) — clé API sur business.wave.com
WAVE_API_KEY=
WAVE_API_BASE=https://api.wave.com
# Secret webhook (POST /payments/webhook/wave), fourni à la création du
# webhook dans le dashboard Wave for Business.
WAVE_WEBHOOK_SECRET=
WAVE_CURRENCY=XOF

# ── Email (production) ─────────────────────────────────────────────
# En dev : laisser vide, Mailpit intercepte tout
SENDGRID_API_KEY=
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@billetix.fr
EMAIL_FROM_NAME=BilletiX

# ── Application ────────────────────────────────────────────────────
APP_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# Utilisé uniquement par les Server Components (dans le conteneur) — nom de
# service Docker, jamais exposé au navigateur.
API_INTERNAL_URL=http://api-gateway:4000/api/v1

# ── Commissions ────────────────────────────────────────────────────
COMMISSION_STANDARD_PERCENT=10
COMMISSION_LARGE_PERCENT=8
COMMISSION_LARGE_THRESHOLD=1000
COMMISSION_FREE_TICKET_FEE=0.50

# ── Paramètres métier ──────────────────────────────────────────────
# Durée de réservation temporaire du stock en secondes (10 min)
STOCK_RESERVATION_TTL_SECONDS=600
# Fenêtre maximale de synchronisation hors ligne (en heures)
OFFLINE_SYNC_MAX_HOURS=4
