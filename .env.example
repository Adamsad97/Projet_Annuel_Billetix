# ══════════════════════════════════════════════════════════════════
# BILLETIX — Variables d'environnement
# Copier ce fichier en .env et remplir toutes les valeurs
# NE JAMAIS committer le fichier .env
# ══════════════════════════════════════════════════════════════════

# ── PostgreSQL ─────────────────────────────────────────────────────
POSTGRES_USER=billetix
POSTGRES_PASSWORD=changeme_postgres
POSTGRES_DB=billetix
POSTGRES_PORT=5432

# ── Redis ──────────────────────────────────────────────────────────
REDIS_PASSWORD=changeme_redis
REDIS_PORT=6379

# ── RabbitMQ ───────────────────────────────────────────────────────
RABBITMQ_USER=billetix
RABBITMQ_PASSWORD=changeme_rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# ── MinIO (stockage S3 local) ──────────────────────────────────────
MINIO_ROOT_USER=billetix
MINIO_ROOT_PASSWORD=changeme_minio_at_least_8_chars
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET_TICKETS=tickets
MINIO_BUCKET_POSTERS=posters
MINIO_BUCKET_AVATARS=avatars

# ── MailHog (SMTP dev local) ───────────────────────────────────────
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025

# ── JWT ────────────────────────────────────────────────────────────
# Générer avec : node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=changeme_jwt_access_secret_minimum_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=changeme_jwt_refresh_secret_minimum_32_chars
JWT_REFRESH_EXPIRES_IN=30d

# ── Sécurité ───────────────────────────────────────────────────────
# Clé AES-256 pour chiffrement IBAN (32 bytes en hex = 64 caractères)
# Générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IBAN_ENCRYPTION_KEY=changeme_iban_key_64_hex_chars_0000000000000000

# Clé HMAC-SHA256 pour signature des QR codes
# Générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
QR_HMAC_SECRET=changeme_qr_hmac_secret_64_hex_chars_000000000000000

# ── OAuth Google ───────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ── Stripe ─────────────────────────────────────────────────────────
# Clés de test disponibles sur dashboard.stripe.com
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── PayPal ─────────────────────────────────────────────────────────
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_MODE=sandbox

# ── Email (production) ─────────────────────────────────────────────
# En dev : laisser vide, MailHog intercepte tout
SENDGRID_API_KEY=
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@billetix.fr
EMAIL_FROM_NAME=BilletiX

# ── Application ────────────────────────────────────────────────────
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1

# ── Commissions ────────────────────────────────────────────────────
COMMISSION_STANDARD_PERCENT=10
COMMISSION_LARGE_PERCENT=8
COMMISSION_LARGE_THRESHOLD=1000
COMMISSION_FREE_TICKET_FEE=0.50

# ── Paramètres métier ──────────────────────────────────────────────
# Durée de réservation temporaire du stock en secondes (10 min)
STOCK_RESERVATION_TTL_SECONDS=600
# Fenêtre maximale de synchronisation hors ligne (en heures)
OFFLINE_SYNC_MAX_HOURS=4
