{
  "name": "billetix",
  "version": "0.1.0",
  "private": true,
  "description": "Plateforme de billetterie électronique — monorepo microservices",
  "scripts": {
    "start": "docker-compose -f docker-compose.yml -f docker-compose.dev.yml up --build",
    "dev": "docker-compose -f docker-compose.yml -f docker-compose.dev.yml up",
    "dev:build": "docker-compose -f docker-compose.yml -f docker-compose.dev.yml up --build",
    "up": "docker-compose -f docker-compose.yml -f docker-compose.dev.yml up -d",
    "up:build": "docker-compose -f docker-compose.yml -f docker-compose.dev.yml up -d --build",
    "dev:backend": "docker-compose -f docker-compose.yml -f docker-compose.dev.yml up -d auth-db user-db event-db order-db ticket-db payment-db admin-db redis rabbitmq minio mailhog api-gateway auth-service user-service event-service order-service ticket-service payment-service notification-service pdf-service admin-service",
    "dev:frontend": "docker-compose -f docker-compose.yml -f docker-compose.dev.yml up -d frontend",
    "stop": "docker-compose stop",
    "down": "docker-compose down",
    "down:volumes": "docker-compose down -v",
    "logs": "docker-compose logs -f",
    "logs:svc": "docker-compose logs -f",
    "ps": "docker-compose ps",
    "infra": "docker-compose up -d auth-db user-db event-db order-db ticket-db payment-db admin-db redis rabbitmq minio mailhog",
    "infra:down": "docker-compose stop auth-db user-db event-db order-db ticket-db payment-db admin-db redis rabbitmq minio mailhog",
    "test:api-gateway": "docker-compose exec api-gateway npm test",
    "test:auth-service": "docker-compose exec auth-service npm test",
    "test:user-service": "docker-compose exec user-service npm test",
    "test:event-service": "docker-compose exec event-service npm test",
    "test:order-service": "docker-compose exec order-service npm test",
    "test:ticket-service": "docker-compose exec ticket-service npm test",
    "test:payment-service": "docker-compose exec payment-service npm test",
    "test:notification-service": "docker-compose exec notification-service npm test",
    "test:pdf-service": "docker-compose exec pdf-service npm test",
    "test:admin-service": "docker-compose exec admin-service npm test",
    "test:all": "node scripts/test-all.js",
    "test:all:local": "node scripts/test-all-local.js",
    "migrate:all": "node scripts/migrate-all.js"
  }
}
